# Copy to .env.prod (git-ignored) for docker-compose.prod.yml.
# Passwords: letters/digits only, e.g. `openssl rand -hex 24`.
MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Comma-separated; these accounts can edit once created with scripts/create-user.mjs.
ADMIN_EMAILS=
